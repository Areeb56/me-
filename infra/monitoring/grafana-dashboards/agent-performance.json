  "links": [],
  "panels": [
    {
      "title": "Agent Run Rate (5m)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "rate(aios_agent_runs_total[5m])",
          "legendFormat": "{{agent_type}} - {{status}}"
        }
      ]
    },
    {
      "title": "Email Send vs Reply Rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "rate(aios_emails_sent_total[5m])",
          "legendFormat": "Sent"
        },
        {
          "expr": "rate(aios_emails_replied_total[5m])",
          "legendFormat": "Replied"
        }
      ]
    },
    {
      "title": "Token Usage by Model",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "rate(aios_tokens_used_total[5m])",
          "legendFormat": "{{model}} ({{agent_type}})"
        }
      ]
    },
    {
      "title": "Deals Won",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "aios_deals_won_total",
          "legendFormat": "Total Won"
        }
      ]
    },
    {
      "title": "Agent Duration P50",
      "type": "heatmap",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "histogram_quantile(0.5, rate(aios_agent_duration_ms_bucket[5m]))",
          "legendFormat": "{{agent_type}}"
        }
      ]
    }
  ],
  "schemaVersion": 38,
