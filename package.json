{
  "name": "aios",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @aios/api db:generate",
    "db:migrate": "pnpm --filter @aios/api db:migrate",
    "db:push": "pnpm --filter @aios/api db:push",
    "db:seed": "pnpm --filter @aios/api db:seed",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "turbo": "^2.0.6",
    "typescript": "^5.5.3"
  },
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
