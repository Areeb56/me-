# Environment variables for AIOS
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/aios

# Redis
REDIS_URL=redis://redis:6379

# ChromaDB
CHROMADB_URL=http://chromadb:8000

# Ollama
OLLAMA_BASE_URL=http://ollama:11434

# API Keys for LLMs (get these from respective providers)
OPENAI_KEY=your_openai_api_key_here
ANTHROPIC_KEY=your_anthropic_api_key_here
OPENROUTER_KEY=your_openrouter_api_key_here

# Other API Keys (for external services)
SENDGRID_API_KEY=your_sendgrid_api_key_here
GITHUB_TOKEN=your_github_token_here

# Application Settings
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# Backend URLs (for frontend)
NEXT_PUBLIC_BACKEND_URL=http://backend:8000
NEXT_PUBLIC_WS_URL=ws://backend:8000

# Backend Server Port
PORT=8000

# Orchestrator
ORCHESTRATOR_URL=http://orchestrator:8001

# Email (SMTP) - for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=AIOS
SMTP_FROM_EMAIL=aios@yourdomain.com

# Email (IMAP) - for receiving emails
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASS=your_app_password

# Admin user (for seeding)
ADMIN_EMAIL=admin@aios.com
ADMIN_PASSWORD=Admin123!

# Environment
NODE_ENV=development

# Encryption
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here
JWT_SECRET=your_jwt_secret_here_change_this_to_a_long_random_string
